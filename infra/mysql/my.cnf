[mysqld]
# Memory-tuned MySQL 8.0 profile for 1GB-2GB VPS (prevents OOM while maximizing InnoDB speed)
performance_schema = OFF
skip-name-resolve = ON
max_connections = 40
max_connect_errors = 1000
wait_timeout = 300
interactive_timeout = 300

# InnoDB Buffer & Log tuning
innodb_buffer_pool_size = 160M
innodb_log_buffer_size = 8M
innodb_redo_log_capacity = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
# Prevent ON DUPLICATE KEY UPDATE from burning millions of auto-increment IDs unnecessarily
innodb_autoinc_lock_mode = 1

# Temp tables & per-thread buffers
tmp_table_size = 16M
max_heap_table_size = 16M
table_open_cache = 400
thread_cache_size = 8

# Fulltext ngram token size = 2 (enables fast matching for "s24", "m3", "16", "hp", etc.)
ngram_token_size = 2

# UTF-8 Default
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
