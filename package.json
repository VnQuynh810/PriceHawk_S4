{
  "name": "pricehawk-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "PriceHawk S4 — Real-time E-commerce Price Comparison Platform (Monorepo)",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "test:unit": "npm --prefix apps/web run test:unit",
    "test:integration": "npm --prefix apps/web run test:integration",
    "test:coverage": "npm --prefix apps/web run test:coverage",
    "package:extension": "node scripts/package-extension.mjs",
    "docker:prod": "docker compose up -d",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  }
}
