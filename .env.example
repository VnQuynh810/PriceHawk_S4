# ── Database Configuration (Shared across Web, Crawler & Chatbot) ──────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me_local_password
DB_NAME=pricecomparison
DB_POOL_LIMIT=10

# ── Next.js Web & Auth ─────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_char_random_hex_secret

# Optional OAuth Providers (auto-skipped if empty)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Internal Services & Caching ────────────────────────────────────────────
CHATBOT_SERVICE_URL=http://localhost:8000
SEARXNG_URL=http://localhost:8083
# Optional Redis for Tier-2/Tier-3 horizontal scaling (falls back to LRU memory cache if empty)
REDIS_URL=

# ── Chatbot LLM & AI Selector Auto-Healer (Groq Cloud OR Ollama Gemma 4) ───
GROQ_API_KEY=your_groq_api_key_here
# Optional: switch AI Selector Healer to self-hosted Ollama Gemma 4 (requires >= 6-8GB RAM worker):
# AI_HEALER_BASE_URL=http://ollama:11434/v1/chat/completions
# AI_HEALER_MODEL=gemma4:e4b

# ── Security Keys (Extension & Internal Cron Triggers) ────────────────────
EXTENSION_API_KEY=replace_with_extension_shared_key
INTERNAL_CRON_SECRET=replace_with_internal_cron_secret
