# ── Production Docker Stack Environment (.env.product) ────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=pricehawk
DB_PASSWORD=replace_with_strong_db_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
DB_NAME=pricecomparison
DB_POOL_LIMIT=10

# ── Next.js Production ─────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://price-hawk.store
NEXTAUTH_URL=https://price-hawk.store
NEXTAUTH_SECRET=replace_with_64_char_random_secret

# Optional OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Internal Services ──────────────────────────────────────────────────────
CHATBOT_SERVICE_URL=http://chatbot:8000
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET_KEY=replace_with_searxng_secret
REDIS_URL=

# ── Chatbot AI ─────────────────────────────────────────────────────────────
GROQ_API_KEY=replace_with_groq_api_key

# ── Security Keys ──────────────────────────────────────────────────────────
EXTENSION_API_KEY=replace_with_extension_shared_key
INTERNAL_CRON_SECRET=replace_with_internal_cron_secret

# ── Container Image Registry (GHCR) ───────────────────────────────────────
GHCR_IMAGE_PREFIX=ghcr.io/pricehawk/pricehawk
IMAGE_TAG=latest
